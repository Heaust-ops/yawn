#!/usr/bin/env bash
set -euo pipefail

run_as_root() {
    if [[ "$(id -u)" -eq 0 ]]; then
        "$@"
    else
        sudo "$@"
    fi
}

run_as_root systemctl start docker
if ! run_as_root docker compose ps --status running --quiet | grep -q .; then
    run_as_root docker compose up --detach
fi

echo "Docker and the Yawn development stack are running."
